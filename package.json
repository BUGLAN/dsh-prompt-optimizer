{
  "name": "dsh-prompt-optimizer",
  "version": "1.2.0",
  "description": "Adds a ✨ icon button to the DSH web composer that optimizes the current draft prompt through the active model, with one-click undo and a Settings page for managing, testing and choosing the default optimization prompt.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/contract.test.mjs test/host.test.mjs test/http.test.mjs test/client.test.mjs test/style-audit.test.mjs",
    "test:style": "node test/style-audit.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "optimizer",
    "web-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmengxiang/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/wmengxiang/dsh-prompt-optimizer",
  "bugs": {
    "url": "https://github.com/wmengxiang/dsh-prompt-optimizer/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1"
  }
}
